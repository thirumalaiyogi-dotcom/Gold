<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ SplashScreen API: navy background + shop logo, then the same navy/logo splash
         continues inside Chrome until the page has loaded (no white flash). -->
    <style name="Theme.STM.Launcher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/navigationColor</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
